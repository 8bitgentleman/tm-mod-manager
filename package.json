{
  "name": "tm-mod-manager",
  "version": "0.1.4",
  "description": "Installs, updates and removes Tricky Madness mods and map packs from the community catalog.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tmm": "src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "megajs": "1.3.10",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  },
  "main": "app/main.mjs",
  "build": {
    "appId": "io.github.8bitgentleman.tm-mod-manager",
    "productName": "Tricky Madness Mods",
    "artifactName": "TrickyMadnessMods-${version}-${os}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**",
      "src/**",
      "package.json",
      "!**/*.test.js"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": "-"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game"
    },
    "publish": {
      "provider": "github",
      "owner": "8bitgentleman",
      "repo": "tm-mod-manager",
      "releaseType": "draft"
    }
  }
}
